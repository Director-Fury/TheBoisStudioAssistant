{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jarvis-tbs-bot",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-26",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "JarvisContainer",
      "scheduling_policy": "default",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "JARVIS_CONTAINER",
        "class_name": "JarvisContainer"
      }
    ]
  },
  "exports": {
    "JarvisContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "WEB_HOST": "0.0.0.0",
    "LOG_LEVEL": "info",
    "LOG_TO_FILE": "false",
    "POSTGRES_PORT": "5432",
    "POSTGRES_SSL": "true",
    "POSTGRES_MAX_CONNECTIONS": "5",
    "POSTGRES_MIN_CONNECTIONS": "0"
  }
}
